# ──────────────────────────────────────────────────
# Rahnuma AI — Environment Variables
# Copy this to .env and fill in the required values
# ──────────────────────────────────────────────────

# ─── Core Settings ───
PROJECT_NAME="Rahnuma AI"
API_V1_STR="/api"
SECRET_KEY="change-this-to-a-random-secret-in-production"

# ─── Database ───
DATABASE_URL="sqlite:///./rahnuma.db"

# ─── Gemini AI (Required for AI features) ───
GEMINI_API_KEY=
PRIMARY_GEMINI_MODEL="gemini-2.0-flash"
FAST_GEMINI_MODEL="gemini-2.0-flash"

# ─── Google Classroom Integration (Optional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Moodle Integration (Optional) ───
MOODLE_BASE_URL=
MOODLE_TOKEN=

# ─── Optional / Deployment ───
# SUPABASE_URL=
# SUPABASE_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
